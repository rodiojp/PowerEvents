<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
	</configSections>	
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="WindowWidth" value="27"/>
		<add key="WindowHeight" value="19"/>
	</appSettings>
	<log4net>
		<!-- UDP Appender for Debug Monitor -->
		<appender name="udp" type="log4net.Appender.UdpAppender">
			<remoteAddress value="127.0.0.2" />
			<remotePort value="9999" />
			<layout type="log4net.Layout.XmlLayout" />
		</appender>
		<!-- Set up an appender to write to a file -->
		<appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
			<file type="log4net.Util.PatternString" value="PowerEvents-log" />
			<datePattern value="-yyyy-MM-dd.'txt'" />
			<!--<rollingStyle value="Date" />-->
			<appendToFile value="true" />
			<maxSizeRollBackups value="10" />
			<maximumFileSize value="100KB" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date{yyyy-MM-dd hh:mm:ss} %-5level [%thread]  %logger - %message%newline" />
			</layout>
		</appender>
		<!--configure loggers-->
		<root>
			<level value="ALL" />
			<appender-ref ref="RollingFile" />
			<!--<appender-ref ref="udp"/>-->
		</root>
	</log4net>
</configuration>